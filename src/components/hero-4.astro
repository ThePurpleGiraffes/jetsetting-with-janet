---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { Icon } from "@/components/ui/icon";
import { Section, SectionContainer } from "@/components/ui/section";

type Props = {
  class?: string;
  title: string;
  description: string;
  features: string[];
  buttons: {
    label: string;
    href: string;
    variant?: "default" | "outline" | "secondary" | "ghost";
  }[];
  image: {
    src: ImageMetadata;
    alt: string;
  };
};

const {
  class: className,
  title,
  description,
  features,
  buttons,
  image,
} = Astro.props;
---

<Section
  class={cn(
    "dark bg-background min-h-[80svh] justify-center px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24",
    className
  )}
>
  <SectionContainer class="relative z-10 items-start gap-8 sm:gap-10 lg:gap-12 text-left">
<h1 class="text-foreground max-w-5xl text-4xl font-semibold leading-[0.95] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl mb-2 sm:mb-4">
  {title}
  <br />
  Connect.
</h1>
    <p
      class="text-foreground/80 max-w-xl text-base leading-relaxed sm:text-lg"
    >
      {description}
    </p>

    <ul class="flex flex-wrap gap-x-5 gap-y-3">
      {
        features.map((feature) => (
          <li class="flex items-center gap-2 text-sm sm:text-base text-white">
            <Icon name="check" class="text-primary size-4 shrink-0" />
            {feature}
          </li>
        ))
      }
    </ul>

    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
      {
        buttons.map(({ href, label, ...button }, index) => (
          <Button
            as="a"
            href={href}
            size="lg"
            class="w-full px-6 py-4 text-base sm:w-auto sm:px-8 sm:py-6 sm:text-lg"
            variant={button.variant ?? (index === 0 ? "default" : "secondary")}
            {...button}
          >
            {label}
          </Button>
        ))
      }
    </div>
  </SectionContainer>

  <div class="bg-background pointer-events-none absolute inset-0">
    <Image
      src={image.src}
      alt={image.alt}
      class="size-full object-cover object-center opacity-50"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
  </div>
</Section>
---
import { Card } from "@/components/ui/card";

// Local partner logos (stored in src/assets/partners/)
import dilmahLogo from "@/assets/partners/dilmah.webp";
import wildebraamLogo from "@/assets/partners/wildebraam-berry-estate.webp";
import darlingSweetLogo from "@/assets/partners/darling-sweet.webp";
import condeNastLogo from "@/assets/partners/conde-nast.webp";

interface Partner {
    img: string;
    alt: string;
}

const partners: Partner[] = [
    {
        img: "https://static.iono.fm/img/iono2/black/ionofm_black_130h.png",
        alt: "Iono FM",
    },
    {
        img: "https://www.schoolguide.co.za/media/jreviews/photos/original/b5/d7/d2/10056-White-and-Gold-logo-12-1387275263.jpg",
        alt: "International Hotel School",
    },
    {
        img: "https://www.capetown.travel/wp-content/uploads/2022/05/logo-love-ct-blue.svg",
        alt: "Cape Town Tourism",
    },
    {
        img: dilmahLogo.src,
        alt: "Dilmah Tea",
    },
    {
        img: wildebraamLogo.src,
        alt: "Wildebraam Berry Estate",
    },
    {
        img: darlingSweetLogo.src,
        alt: "Darling Sweet",
    },
    {
        img: condeNastLogo.src,
        alt: "Condé Nast",
    },
];
---

<section class="bg-muted/30 py-24">
    <div class="container mx-auto max-w-7xl px-4">
        <div class="space-y-12">
            <div class="text-center">
                <p
                    class="text-primary text-m font-semibold uppercase tracking-[0.2em]"
                >
                    Partners
                </p>
            </div>

            <!-- Flex-wrap keeps rows centred, so an odd number of logos never leaves one stranded on the left -->
            <div class="flex flex-wrap justify-center gap-6">
                {
                    partners.map((partner) => (
                        <Card class="flex h-32 w-[calc(50%-0.75rem)] items-center justify-center p-6 transition-shadow hover:shadow-md sm:w-36">
                            <img
                                src={partner.img}
                                alt={partner.alt}
                                loading="lazy"
                                class="max-h-16 w-auto max-w-full object-contain transition hover:grayscale-0"
                            />
                        </Card>
                    ))
                }
            </div>
        </div>
    </div>
</section>

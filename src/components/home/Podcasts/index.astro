---
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Icon } from "@/components/ui/icon";

const platforms = [
    {
        title: "Spotify",
        icon: "mdi:spotify",
        href: "https://open.spotify.com/show/0sxZ5C8iqU8INGghXB8oon",
    },
    {
        title: "Apple Podcasts",
        icon: "simple-icons:applepodcasts",
        href: "https://podcasts.apple.com/us/podcast/jetsetting-with-janet/id1692738648",
    },
    {
        title: "Iono FM",
        icon: "mdi:radio",
        href: "https://iono.fm/c/8113",
    },
];
---

<section class="bg-[#080302] py-20 lg:py-32 xl:py-40">
    <div class="container mx-auto max-w-7xl px-4">
        <div class="grid gap-12 lg:grid-cols-[500px_1fr] lg:items-center">
            <div class="space-y-6">
                <p
                    class="text-primary text-sm font-semibold uppercase tracking-[0.2em]"
                >
                    The Jetsetting with Janet Podcast
                </p>

                <h2
                    class="font-serif text-4xl font-medium leading-tight text-white md:text-5xl"
                >
                    Inspiring conversations. Industry insights.
                </h2>

                <p class="text-white/70">
                    Twice a week on Iono FM, Apple Podcasts and Spotify.
                </p>

                <a href="/podcast">
                    <Button
                        class="rounded-none px-6 py-6 text-sm font-semibold uppercase tracking-[0.1em]"
                    >
                        Listen To Latest Episode
                    </Button>
                </a>
                
            </div>

            <div class="space-y-4">
                {
                    platforms.map((platform) => (
                        <a href={platform.href}>
                            <Card class="group border-white/20 bg-transparent p-0 transition-all duration-300 hover:border-white/40 hover:bg-white/5">
                                <div class="flex items-center gap-5 p-6">
                                    <div class="flex h-14 w-14 items-center justify-center rounded-full border border-white/20 bg-white">
                                        <Icon
                                            name={platform.icon}
                                            class:list={[
                                                "h-7 w-7",
                                                platform.title === "Spotify"
                                                    ? "text-[#1DB954]"
                                                    : "text-black",
                                            ]}
                                        />
                                    </div>

                                    <div class="flex-1">
                                        <p class="text-sm text-white/60">
                                            Listen on
                                        </p>

                                        <h3 class="text-2xl font-bold text-white">
                                            {platform.title}
                                        </h3>
                                    </div>

                                    <Icon
                                        name="lucide:external-link"
                                        class="h-5 w-5 text-white/50 transition group-hover:text-white"
                                    />
                                </div>
                            </Card>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>

---
/**
 * About page – Jetsetting with Janet
 * Route: /about-janet  (the site footer already links here)
 *
 * Images: put the WebP files in  src/assets/about/
 * Layout: uses the site's existing layout so the header and footer stay consistent.
 *         Adjust the import path / props below if your layout file is named differently.
 */
import { Image } from "astro:assets";
import MainLayout from "../layouts/Mainlayout.astro";

import portrait from "../assets/about/janet-pillai-portrait.webp";
import noordhoek from "../assets/about/noordhoek-sunset.webp";
import tableMountain from "../assets/about/cape-town-table-mountain.webp";
import blackCoat from "../assets/about/janet-pillai-black-coat.webp";
import seated from "../assets/about/janet-pillai-seated.webp";

const title = "About Jetsetting with Janet | Janet Pillai, Founder & Host";
const description =
  "Jetsetting with Janet is a Cape Town travel, lifestyle and destination storytelling platform founded by Janet Pillai, connecting people with the stories, cultures and experiences that make South Africa meaningful.";

const site = Astro.site ?? new URL("https://jetsettingwithjanet.com");
const portraitUrl = new URL(portrait.src, site).href;

// Structured data (AboutPage + Organization + Person) for Google and AI answer engines
const schema = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AboutPage",
        "@id": "https://jetsettingwithjanet.com/about-janet#webpage",
        "url": "https://jetsettingwithjanet.com/about-janet",
        "name": "About Jetsetting with Janet",
        "about": { "@id": "https://jetsettingwithjanet.com/#organization" },
        "mainEntity": { "@id": "https://jetsettingwithjanet.com/#janet-pillai" }
      },
      {
        "@type": "Organization",
        "@id": "https://jetsettingwithjanet.com/#organization",
        "name": "Jetsetting with Janet",
        "alternateName": "JwJ",
        "url": "https://jetsettingwithjanet.com/",
        "slogan": "Wellness is the ultimate destination.",
        "description": "A South African travel, lifestyle and destination storytelling platform connecting people with the destinations, experiences, cultures, businesses and stories that make travel meaningful.",
        "email": "hello@jetsettingwithjanet.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Cape Town", "addressCountry": "ZA" },
        "founder": { "@id": "https://jetsettingwithjanet.com/#janet-pillai" },
        "sameAs": [
          "https://www.youtube.com/@jetsettingwithjanet3337",
          "https://www.instagram.com/jetsettingwithjanet1/",
          "https://www.facebook.com/jetsettingwithjanet",
          "https://open.spotify.com/show/0sxZ5C8iqU8INGghXB8oon",
          "https://podcasts.apple.com/us/podcast/jetsetting-with-janet/id1692738648"
        ]
      },
      {
        "@type": "Person",
        "@id": "https://jetsettingwithjanet.com/#janet-pillai",
        "name": "Janet Pillai",
        "jobTitle": "Founder & Host, Jetsetting with Janet",
        "image": portraitUrl,
        "address": { "@type": "PostalAddress", "addressLocality": "Cape Town", "addressCountry": "ZA" },
        "worksFor": [
          { "@type": "Organization", "name": "Multilayer Trade Corporation (MLT Corp)" },
          { "@type": "Organization", "name": "Articulate" },
          { "@type": "Organization", "name": "Inuversal Group" }
        ],
        "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Durban-Westville" },
        "sameAs": ["https://www.linkedin.com/in/janetpillai"]
      }
    ]
  };
---

<MainLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="jwj-about">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
      <symbol id="i-map" viewBox="0 0 24 24"><path d="M14.1 5.4 9.9 3.6a2 2 0 0 0-1.6 0L3.6 5.6A1 1 0 0 0 3 6.5v13a1 1 0 0 0 1.4.9l3.9-1.7a2 2 0 0 1 1.6 0l4.2 1.8a2 2 0 0 0 1.6 0l4.7-2a1 1 0 0 0 .6-.9v-13a1 1 0 0 0-1.4-.9l-3.9 1.7a2 2 0 0 1-1.6 0zM9 3.5v15M15 5.5v15"/></symbol>
      <symbol id="i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.1 6.4-6.4 2.1 2.1-6.4z"/></symbol>
      <symbol id="i-chef" viewBox="0 0 24 24"><path d="M17 21a1 1 0 0 0 1-1v-5.4a5 5 0 0 0-1.3-9.6 6 6 0 0 0-9.4 0A5 5 0 0 0 6 14.6V20a1 1 0 0 0 1 1zM6 17h12"/></symbol>
      <symbol id="i-landmark" viewBox="0 0 24 24"><path d="M3 22h18M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 2l8 5H4z"/></symbol>
      <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/></symbol>
      <symbol id="i-mic" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></symbol>
      <symbol id="i-briefcase" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2M2 13h20"/></symbol>
      <symbol id="i-megaphone" viewBox="0 0 24 24"><path d="m3 11 18-5v12L3 14v-3zM11.6 16.8a3 3 0 1 1-5.8-1.6"/></symbol>
      <symbol id="i-heart" viewBox="0 0 24 24"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/></symbol>
      <symbol id="i-hand" viewBox="0 0 24 24"><path d="m11 17 2 2a1 1 0 1 0 3-3M14 14l2.5 2.5a1 1 0 1 0 3-3l-3.9-3.9a3 3 0 0 0-4.2 0l-.9.9a1 1 0 1 1-3-3l2.8-2.8a5.8 5.8 0 0 1 7.1-.9l.5.3a2 2 0 0 0 1.4.2L21 4M21 3l1 11h-2M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3M3 4h8"/></symbol>
      <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></symbol>
      <symbol id="i-bulb" viewBox="0 0 24 24"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5M9 18h6M10 22h4"/></symbol>
      <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/></symbol>
      <symbol id="i-sprout" viewBox="0 0 24 24"><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8zM14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/></symbol>
      <symbol id="i-plane" viewBox="0 0 24 24"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></symbol>
      <symbol id="i-school" viewBox="0 0 24 24"><path d="M22 10 12 5 2 10l10 5 10-5zM6 12v5c3 3 9 3 12 0v-5"/></symbol>
      <symbol id="i-building" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/></symbol>
      <symbol id="i-sparkle" viewBox="0 0 24 24"><path d="M9.9 15.5A2 2 0 0 0 8.5 14l-6.1-1.6a.5.5 0 0 1 0-1L8.5 10A2 2 0 0 0 10 8.5l1.6-6.1a.5.5 0 0 1 1 0L14 8.5a2 2 0 0 0 1.5 1.5l6.1 1.6a.5.5 0 0 1 0 1L15.5 14a2 2 0 0 0-1.5 1.5l-1.6 6.1a.5.5 0 0 1-1 0z"/></symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></symbol>
    </svg>


    <!-- ================= 1. HERO ================= -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">About Jetsetting with Janet</p>
          <h1>Beyond the destination.</h1>
          <p class="lead">Jetsetting with Janet is a Cape Town–based travel, lifestyle and destination storytelling platform. We connect people with the places, cultures, flavours, businesses and people that make South Africa unforgettable, because the best journeys are measured by what we discover, who we meet and the stories we take home.</p>
          <ul class="ticks">
            <li><svg><use href="#i-check"/></svg>Travel</li>
            <li><svg><use href="#i-check"/></svg>Culture</li>
            <li><svg><use href="#i-check"/></svg>Lifestyle</li>
            <li><svg><use href="#i-check"/></svg>Storytelling</li>
            <li><svg><use href="#i-check"/></svg>Experiences</li>
          </ul>
          <div class="btn-row">
            <a class="btn btn-primary" href="#founder">Meet Janet</a>
            <a class="btn btn-dark" href="#partner">Partner With Us</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="frame" aria-hidden="true"></div>
          <Image src={portrait} alt="Portrait of Janet Pillai, founder and host of Jetsetting with Janet" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high" />
          <div class="hero-caption">
            <span>Founder &amp; Host</span>
            <strong>Janet Pillai</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 2. OUR STORY ================= -->
    <section class="section section-muted" id="story">
      <div class="container split">
        <div>
          <p class="eyebrow">Our Story</p>
          <h2 class="h2" style="margin-top:.75rem">Every destination has a story.</h2>
          <div class="prose" style="margin-top:1.5rem">
            <p>Founded by Janet Pillai and headquartered in Cape Town, Jetsetting with Janet (JwJ) takes audiences beyond conventional sightseeing to explore the food, heritage, hospitality, wellness and culture that shape a destination.</p>
            <p>What began as a travel media platform has grown into a broader experiential tourism and lifestyle brand. We bring together media, storytelling, content creation and strategic partnerships to promote South Africa as a destination, and to create meaningful opportunities for the tourism businesses, cultural institutions, hospitality brands and experience providers who make it special.</p>
            <p>Our projects span culinary tourism, heritage tourism, cultural experiences, destination storytelling and tourism partnerships, all built around one simple idea: travel is ultimately about connection.</p>
          </div>
          <div class="pillars">
            <div class="pillar"><strong>People</strong><span>The faces behind tourism</span></div>
            <div class="pillar"><strong>Place</strong><span>Destinations with depth</span></div>
            <div class="pillar"><strong>Purpose</strong><span>Tourism that gives back</span></div>
          </div>
        </div>
        <div class="story-media">
          <Image src={noordhoek} alt="Golden sunset over the wetlands and coastline at Noordhoek, Cape Town" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" class="tall" />
          <div class="note">
            <p>“Wellness is the ultimate destination.”</p>
            <span>The JwJ philosophy</span>
          </div>
          <Image src={tableMountain} alt="Table Mountain at sunset across the ocean, Cape Town" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" class="short" />
        </div>
      </div>
    </section>

    <!-- ================= 3. VISION & MISSION ================= -->
    <section class="section">
      <div class="container">
        <div class="vm-grid">
          <div class="card gold">
            <p class="eyebrow">Our Vision</p>
            <p>To become a leading African travel and lifestyle storytelling platform that inspires people to travel differently, experience deeply and connect meaningfully.</p>
          </div>
          <div class="card">
            <p class="eyebrow">Our Mission</p>
            <h3>Authentic stories that grow South Africa’s tourism economy.</h3>
            <ul class="checklist cols">
              <li><svg><use href="#i-check"/></svg>Promote South African destinations and experiences</li>
              <li><svg><use href="#i-check"/></svg>Showcase the people behind the tourism economy</li>
              <li><svg><use href="#i-check"/></svg>Create commercially viable experiential tourism products</li>
              <li><svg><use href="#i-check"/></svg>Connect tourism businesses with new audiences and markets</li>
              <li><svg><use href="#i-check"/></svg>Champion heritage and cultural tourism</li>
              <li><svg><use href="#i-check"/></svg>Support local tourism SMMEs</li>
              <li><svg><use href="#i-check"/></svg>Encourage domestic travel and attract international visitors</li>
              <li><svg><use href="#i-check"/></svg>Turn destinations into experiences through storytelling</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 4. WHAT WE DO ================= -->
    <section class="section section-muted" id="what-we-do">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What We Do</p>
          <h2 class="h2">Travel that invites you to take part, not just look on.</h2>
          <p class="lead">From destination features to immersive culinary and heritage journeys, every JwJ project is designed to help travellers participate rather than simply observe.</p>
        </div>
        <div class="grid-3">
          <article class="card offer">
            <span class="icon-badge"><svg class="icon"><use href="#i-map"/></svg></span>
            <h3>Travel &amp; Destination Storytelling</h3>
            <p>Engaging stories about destinations, attractions, accommodation, restaurants, events and the people who make tourism possible, with a special connection to Cape Town and the Western Cape.</p>
          </article>
          <article class="card offer">
            <span class="icon-badge"><svg class="icon"><use href="#i-compass"/></svg></span>
            <h3>Experiential Tourism</h3>
            <p>Curated experiences that blend travel, food, culture, heritage, wellness and people, so visitors leave with memories and not just photographs.</p>
          </article>
          <article class="card offer">
            <span class="icon-badge"><svg class="icon"><use href="#i-chef"/></svg></span>
            <h3>Culinary Tourism</h3>
            <p>Food as an entry point into culture, history and human connection: dining experiences that go far beyond the plate.</p>
          </article>
          <article class="card offer">
            <span class="icon-badge"><svg class="icon"><use href="#i-landmark"/></svg></span>
            <h3>Heritage &amp; Cultural Tourism</h3>
            <p>Journeys that connect visitors with South Africa’s history and identity. We believe heritage should not only preserve the past, it should create meaningful experiences today.</p>
          </article>
          <article class="card offer">
            <span class="icon-badge"><svg class="icon"><use href="#i-leaf"/></svg></span>
            <h3>Lifestyle &amp; Wellness</h3>
            <p>Exploring how travel nourishes physical, emotional, cultural and social wellbeing for the modern traveller seeking more than a getaway.</p>
          </article>
          <article class="card offer">
            <span class="icon-badge"><svg class="icon"><use href="#i-mic"/></svg></span>
            <h3>Media &amp; Content</h3>
            <p>Interviews, podcasts, video, destination features, travel reviews, event coverage, social media, branded storytelling and tourism campaigns.</p>
          </article>
        </div>
        <p class="formula">
          <b>Travel</b><i>+</i><b>Food</b><i>+</i><b>Culture</b><i>+</i><b>Heritage</b><i>+</i><b>Wellness</b><i>+</i><b>Storytelling</b><i>+</i><b>People</b>
        </p>
      </div>
    </section>

    <!-- ================= 5. DIFFERENTIATOR ================= -->
    <section class="section section-dark">
      <div class="container">
        <div class="diff">
          <p class="eyebrow">Our Difference</p>
          <p class="ask">We don’t simply ask <s>“Where can you go?”</s></p>
          <p class="answer">We ask: <em>“What story will you discover when you get there?”</em></p>
          <div class="story-lines">
            <div><strong>Every destination</strong>has a story.</div>
            <div><strong>Every meal</strong>has a story.</div>
            <div><strong>Every heritage site</strong>has a story.</div>
            <div><strong>Every entrepreneur</strong>has a story.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 6. FLAGSHIP PROJECTS ================= -->
    <section class="section" id="projects">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Flagship Projects</p>
          <h2 class="h2">Stories you can step into.</h2>
        </div>
        <div class="projects">
          <article class="project feature p-lg">
            <span class="tag">Heritage Tourism</span>
            <h3>Footsteps to Freedom</h3>
            <p>A Cape Town heritage journey connecting the significant sites and stories of South Africa’s path to democracy, brought to life through storytelling and curated visitor experiences.</p>
          </article>
          <article class="project cream p-lg">
            <span class="tag">Culinary Tourism</span>
            <h3>Beyond the Plate</h3>
            <p>An immersive culinary experience that uses food as a gateway to culture, travel, heritage, wellness and human connection, developed in partnership with the International Hotel School in Cape Town.</p>
          </article>
          <article class="project p-sm">
            <span class="tag">Coming Soon</span>
            <h3>Culture Vulture</h3>
            <p>A proposed cultural experience connecting visitors with Cape Town’s theatre, arts and entertainment landscape.</p>
          </article>
          <article class="project p-sm">
            <span class="tag">Editorial</span>
            <h3>Destination Stories</h3>
            <p>A growing portfolio of features on South African destinations, stays, restaurants, attractions and tourism entrepreneurs.</p>
          </article>
          <article class="project p-sm">
            <span class="tag">Media</span>
            <h3>JwJ Media</h3>
            <p>Conversations with tourism leaders, hospitality professionals, creatives, cultural practitioners and destination personalities.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 7. MEET THE FOUNDER ================= -->
    <section class="section section-muted" id="founder">
      <div class="container split">
        <div class="founder-media">
          <Image src={blackCoat} alt="Janet Pillai, entrepreneur, executive and founder of Jetsetting with Janet" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" />
          <div class="badge"><strong>20+</strong><span>years leading organisations across transport, tourism, communications and healthcare</span></div>
        </div>
        <div>
          <p class="eyebrow">Meet the Founder</p>
          <h2 class="h2" style="margin-top:.75rem">Janet Pillai</h2>
          <p class="role-line">Entrepreneur &nbsp;|&nbsp; Executive &nbsp;|&nbsp; Strategic Leader</p>
          <div class="prose" style="margin-top:1.5rem">
            <p>For more than two decades, Janet Pillai has led organisations at the intersection of transport, tourism, communications and healthcare, earning a reputation as a strategic leader who turns vision into sustainable growth.</p>
            <p>As Founder and CEO of Multilayer Trade Corporation (MLT Corp), she has built one of South Africa’s trusted providers of integrated transport, accommodation and logistics solutions for the corporate, government, tourism and maritime sectors. She also founded Articulate, a communications and strategic marketing agency, and serves as Chief Operating Officer of Inuversal Group, an emerging precision healthcare organisation.</p>
            <p>Her career spans academia, public service and entrepreneurship, underpinned by internationally recognised work in heritage preservation, governance and organisational leadership. That experience shapes Jetsetting with Janet’s distinctive approach: connecting business, culture, people and place.</p>
          </div>
          <blockquote class="pullquote">“Building businesses that move people, industries and ideas forward.”</blockquote>
          <div class="roles">
            <div class="role"><span class="icon-badge"><svg class="icon"><use href="#i-briefcase"/></svg></span><div><strong>Founder &amp; CEO</strong><span>MLT Corporation</span></div><em>2002 – Present</em></div>
            <div class="role"><span class="icon-badge"><svg class="icon"><use href="#i-megaphone"/></svg></span><div><strong>Founder</strong><span>Articulate</span></div><em>2012 – Present</em></div>
            <div class="role"><span class="icon-badge"><svg class="icon"><use href="#i-heart"/></svg></span><div><strong>Chief Operating Officer</strong><span>Inuversal Group</span></div><em>Present</em></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 8. BY THE NUMBERS ================= -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">By the Numbers</p>
          <h2 class="h2">A legacy of leadership. A future of impact.</h2>
        </div>
        <div class="stats">
          <div class="stat"><strong>24+</strong><span>Years leading MLT Corporation</span></div>
          <div class="stat"><strong>30+</strong><span>Years of executive leadership experience</span></div>
          <div class="stat"><strong>3</strong><span>Businesses founded and led</span></div>
        </div>
      </div>
    </section>

    <!-- ================= 9. LEADERSHIP JOURNEY ================= -->
    <section class="section" id="journey">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Leadership Journey</p>
          <h2 class="h2">A career rooted in purpose, built on impact.</h2>
        </div>
        <div class="split journey">
          <ol class="timeline">
            <li>
              <p class="when">1994 – Present</p>
              <h3>Visiting Fellow &amp; Curator</h3>
              <p class="org">University of Fort Hare, Eastern Cape</p>
              <p>Collections management, museum and archival work, and digitisation of liberation-struggle records, including a catalogue of artworks from the ANC Archives and mirror archives with the Universities of Michigan and Connecticut.</p>
            </li>
            <li>
              <p class="when">1997 – 1998</p>
              <h3>International Fellowships</h3>
              <p class="org">University of Michigan &amp; Smithsonian Institution</p>
              <p>Awarded the King-Chavez-Parks Visiting Professorship (University of Michigan Ann Arbor and Michigan State University) and a Visiting Fellowship to the Smithsonian Institution, researching South African liberation archives and cultural heritage.</p>
            </li>
            <li>
              <p class="when">Public Service</p>
              <h3>Director: Arts, Culture &amp; Heritage</h3>
              <p class="org">Western Cape Provincial Government</p>
              <p>Led the Arts, Culture and Heritage portfolio, driving policy, strategic planning and the promotion of cultural preservation and economic development.</p>
            </li>
            <li>
              <p class="when">2002 – Present</p>
              <h3>Founder &amp; CEO</h3>
              <p class="org">Multilayer Trade Corporation (MLT Corp)</p>
              <p>Transport, shuttle and accommodation solutions for corporate, government, tourism and maritime clients, built on reliability, service excellence and innovation.</p>
            </li>
            <li>
              <p class="when">2012 – Present</p>
              <h3>Founder</h3>
              <p class="org">Articulate</p>
              <p>Strategic marketing, communications, PR and events, helping companies amplify their brand through end-to-end campaigns.</p>
            </li>
            <li>
              <p class="when">Present</p>
              <h3>Founder &amp; Host</h3>
              <p class="org">Jetsetting with Janet</p>
              <p>Championing conversations that inspire growth, empowerment and leadership, and building experiences that put South African stories at the heart of travel.</p>
            </li>
          </ol>

          <div class="side-stack">
            <div class="card">
              <p class="eyebrow">Recognition</p>
              <ul class="mini-list">

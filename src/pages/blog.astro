        <!-- Newsletter -->
        <section class="py-24">
            <div class="container mx-auto max-w-4xl px-4">
                <Card class="text-center">
                    <h2 class="font-serif text-4xl">Stay Inspired</h2>

                    <p class="text-muted-foreground mt-4">
                        Receive the latest travel stories, hospitality insights
                        and exclusive experiences.
                    </p>

                    <div class="mt-8 flex flex-col gap-4 md:flex-row">
                        <input
                            type="email"
                            placeholder="Enter your email"
                            class="flex-1 rounded-none border px-4 py-3"
                        />

                        <Button class="rounded-none uppercase tracking-[0.1em]">
                            Subscribe
                        </Button>
                    </div>
                </Card>
            </div>
        </section>
    </section>
</Mainlayout>
